{
  "name": "base44-sdk-mcp",
  "version": "1.0.0",
  "description": "MCP server for Base44 SDK documentation - Community project",
  "type": "module",
  "author": "Leonid Rise <https://www.linkedin.com/in/leonid-rise/>",
  "license": "MIT",
  "homepage": "https://doc-sdk.base44.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/elirais/base44-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "base44",
    "sdk",
    "documentation",
    "ai",
    "claude",
    "cursor",
    "unofficial",
    "community"
  ],
  "bin": {
    "base44-mcp-server": "./build/stdio.js"
  },
  "module": "src/index.ts",
  "files": [
    "src/",
    "build/",
    ".smithery/",
    "README.md",
    "INSTALLATION.md",
    "TROUBLESHOOTING.md",
    "SMITHERY_SUBMISSION.md"
  ],
  "scripts": {
    "dev": "npx @smithery/cli dev",
    "build": "npx @smithery/cli build",
    "build:stdio": "tsc && chmod +x build/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build:stdio"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.53",
    "@modelcontextprotocol/sdk": "^1.17.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@smithery/cli": "^1.4.6",
    "@types/node": "^25.2.2",
    "@vercel/node": "^23.0.1",
    "typescript": "^5.8.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
